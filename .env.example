# Required local-only profile. Do not change this value in the default setup.
LOCAL_DEVELOPMENT_PROFILE=zero-cost-local
NODE_ENV=development
LOG_LEVEL=info

# Host-process endpoints. Docker Compose injects service-host equivalents for
# containers, so this file remains convenient for host development.
DATABASE_URL=postgresql://pulsefield:pulsefield_local_only@localhost:5432/pulsefield?schema=public
# Optional integration-test override. When omitted, the test runner derives
# pulsefield_test from DATABASE_URL and still enforces the local _test guard.
# TEST_DATABASE_URL=postgresql://pulsefield:pulsefield_local_only@localhost:5432/pulsefield_test?schema=public
QUEUE_REDIS_URL=redis://localhost:6379/0
EPHEMERAL_REDIS_URL=redis://localhost:6380/0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_ALLOW_EXTERNAL=false
# Generate this ignored local-only secret after copying the file:
# pnpm local:secrets
# MESSAGE_ENCRYPTION_KEY_BASE64 and MESSAGE_ENCRYPTION_PREVIOUS_KEY_BASE64 are intentionally not committed.
OUTBOX_RELAY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PRODUCT_MEDIA_ROOT=./.local/media

# Local application addresses.
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
WORKER_PORT=4001

# Provider safety guardrails. Phase 1 has no active payment provider.
PAYMENT_PROVIDER=stub
STRIPE_ENABLED=false
BILLABLE_ADAPTERS_ENABLED=false

# Optional ignored credentials used only by the disposable Phase 3 demo reset.
# PHASE3_DEMO_ADMIN_PASSWORD=
# PHASE3_DEMO_FULFILLER_PASSWORD=
