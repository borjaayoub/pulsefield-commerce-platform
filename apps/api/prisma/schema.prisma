generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Phase 1's persisted foundation model. It records versioned, non-commercial
/// bootstrap configuration; business modules receive their own owned tables
/// and explicit migrations in their approved phases.
model FoundationSetting {
  key            String                      @id @db.VarChar(128)
  value          Json
  version        Int                         @default(1)
  latestRevision Int                         @default(1)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  revisions      FoundationSettingRevision[]
}

enum FoundationSettingLifecycle {
  DRAFT
  APPROVED
  ACTIVE
  RETIRED
}

enum AuditActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED_RETRYABLE
}

model IdempotencyRecord {
  id                          String                       @id @default(uuid()) @db.Uuid
  actorType                   AuditActorType
  actorId                     String                       @db.VarChar(128)
  operation                   String                       @db.VarChar(128)
  keyDigest                   String                       @db.Char(64)
  requestFingerprint          String                       @db.Char(64)
  status                      IdempotencyStatus            @default(IN_PROGRESS)
  claimTokenDigest            String?                      @db.Char(64)
  lockedUntil                 DateTime?
  attemptCount                Int                          @default(1)
  resultType                  String?                      @db.VarChar(128)
  resultId                    String?                      @db.VarChar(128)
  responseStatus              Int?
  lastErrorCode               String?                      @db.VarChar(64)
  completedAt                 DateTime?
  expiresAt                   DateTime
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  fulfillmentTransitionResult FulfillmentTransitionResult?

  @@unique([actorType, actorId, operation, keyDigest])
  @@index([status, lockedUntil])
  @@index([expiresAt])
}

model AuditRecord {
  id             String         @id @default(uuid()) @db.Uuid
  schemaVersion  Int            @default(1)
  actorType      AuditActorType
  actorId        String         @db.VarChar(128)
  actorRoles     String[]
  action         String         @db.VarChar(128)
  targetType     String         @db.VarChar(128)
  targetId       String         @db.VarChar(128)
  requestId      String         @db.VarChar(128)
  correlationId  String         @db.VarChar(128)
  causationId    String?        @db.VarChar(128)
  idempotencyKey String         @db.VarChar(128)
  reason         String         @db.VarChar(500)
  beforeMetadata Json?
  afterMetadata  Json?
  occurredAt     DateTime       @default(now())

  @@index([occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId, occurredAt])
}

model AuditRetentionHold {
  id         String    @id @default(uuid()) @db.Uuid
  reason     String    @db.VarChar(500)
  createdBy  String    @db.VarChar(128)
  expiresAt  DateTime
  releasedAt DateTime?
  releasedBy String?   @db.VarChar(128)
  createdAt  DateTime  @default(now())

  @@index([releasedAt, expiresAt])
}

model FoundationSettingRevision {
  id                    String                     @id @default(uuid()) @db.Uuid
  setting               FoundationSetting          @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  settingKey            String                     @db.VarChar(128)
  version               Int
  value                 Json
  lifecycle             FoundationSettingLifecycle
  validationResult      Json
  authoredBy            String                     @db.VarChar(128)
  approvedBy            String?                    @db.VarChar(128)
  activatedBy           String?                    @db.VarChar(128)
  retiredBy             String?                    @db.VarChar(128)
  sourceRevisionVersion Int?
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  lockVersion           Int                        @default(1)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([settingKey, version])
  @@index([settingKey, lifecycle])
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum RoleName {
  CUSTOMER
  FULFILLER
  ADMINISTRATOR
}

enum OutboxMessageStatus {
  PENDING
  PUBLISHED
  DEAD_LETTER
}

enum NotificationDeliveryType {
  EMAIL_VERIFICATION
  PASSWORD_RECOVERY
}

enum NotificationDeliveryStatus {
  QUEUED
  ACCEPTED
  FAILED_TERMINAL
}

enum CatalogLifecycle {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceBookVersionLifecycle {
  DRAFT
  ACTIVE
  RETIRED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  INITIAL_STOCK
  ADJUSTMENT
  RESERVED
  RESERVATION_RELEASED
  RESERVATION_EXPIRED
  RESERVATION_COMMITTED
  FULFILLMENT_DECREMENT
}

enum CartStatus {
  OPEN
  CHECKOUT_PENDING
  CONVERTED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  MANUAL_RESOLUTION
}

enum PaymentAttemptStatus {
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentWebhookEventType {
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentWebhookInboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  TERMINAL_FAILURE
}

enum PaymentCompensationReason {
  LATE_SUCCESS_STOCK_UNAVAILABLE
}

enum PaymentCompensationStatus {
  REQUIRED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FulfillmentGroupStatus {
  ALLOCATED
  PICKING
  PACKED
  SHIPPED
  DELIVERED
}

enum CommercePolicyLifecycle {
  DRAFT
  ACTIVE
  RETIRED
}

model User {
  id                           String                   @id @default(uuid()) @db.Uuid
  emailNormalized              String                   @unique @db.VarChar(255)
  passwordHash                 String                   @db.VarChar(255)
  verifiedAt                   DateTime?
  verificationEmailRequestedAt DateTime?
  passwordRecoveryRequestedAt  DateTime?
  credentialVersion            Int                      @default(1)
  totpSecretCiphertext         String?                  @db.Text
  totpEnrolledAt               DateTime?
  totpLastUsedStep             BigInt?
  status                       AccountStatus            @default(PENDING_VERIFICATION)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  userRoles                    UserRole[]
  verificationTokens           EmailVerificationToken[]
  passwordResetTokens          PasswordResetToken[]
  mfaRecoveryCodes             MfaRecoveryCode[]
  notificationDeliveries       NotificationDelivery[]
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model UserRole {
  id     String   @id @default(uuid()) @db.Uuid
  user   User     @relation(fields: [userId], references: [id])
  userId String   @db.Uuid
  role   RoleName

  @@unique([userId, role])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model OutboxMessage {
  id             String              @id @default(uuid()) @db.Uuid
  eventType      String              @db.VarChar(128)
  eventVersion   Int
  aggregateType  String              @db.VarChar(128)
  aggregateId    String              @db.VarChar(128)
  payload        Json
  correlationId  String              @db.VarChar(128)
  causationId    String?             @db.VarChar(128)
  status         OutboxMessageStatus @default(PENDING)
  availableAt    DateTime            @default(now())
  claimedAt      DateTime?
  claimedBy      String?             @db.VarChar(128)
  attemptCount   Int                 @default(0)
  lastError      String?             @db.VarChar(2000)
  publishedAt    DateTime?
  deadLetteredAt DateTime?
  occurredAt     DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, availableAt, occurredAt])
  @@index([claimedAt])
}

model NotificationDelivery {
  id                 String                     @id @default(uuid()) @db.Uuid
  sourceEventId      String                     @unique @db.Uuid
  user               User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId             String                     @db.Uuid
  type               NotificationDeliveryType
  status             NotificationDeliveryStatus @default(QUEUED)
  correlationId      String                     @db.VarChar(128)
  queuedAt           DateTime                   @default(now())
  acceptedAt         DateTime?
  failedAt           DateTime?
  failureCode        String?                    @db.VarChar(64)
  workerAttemptCount Int                        @default(0)
  replayedAt         DateTime?
  replayedBy         String?                    @db.VarChar(128)
  updatedAt          DateTime                   @updatedAt

  @@index([status, queuedAt])
  @@index([userId, queuedAt])
}

model Product {
  id                         String            @id @default(uuid()) @db.Uuid
  name                       String            @db.VarChar(160)
  description                String            @db.Text
  status                     CatalogLifecycle  @default(DRAFT)
  specificationSchemaVersion Int               @default(1)
  specifications             Json
  archivedAt                 DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  slugs                      ProductSlug[]
  variants                   ProductVariant[]
  categories                 ProductCategory[]
  media                      ProductMedia[]

  @@index([status, createdAt, id])
  @@index([status, name, id])
}

model ProductSlug {
  id          String   @id @default(uuid()) @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   String   @db.Uuid
  slug        String   @unique @db.VarChar(160)
  isCanonical Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId, isCanonical])
}

model ProductVariant {
  id                  String                     @id @default(uuid()) @db.Uuid
  product             Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId           String                     @db.Uuid
  sku                 String                     @unique @db.VarChar(64)
  name                String                     @db.VarChar(160)
  optionSchemaVersion Int                        @default(1)
  optionValues        Json
  weightGrams         Int
  taxClass            String                     @db.VarChar(64)
  status              CatalogLifecycle           @default(DRAFT)
  archivedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  prices              VariantPrice[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  cartItems           CartItem[]
  reservationItems    InventoryReservationItem[]
  orderLines          OrderLine[]

  @@index([productId, status, id])
}

model Category {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            @db.VarChar(120)
  slug       String            @unique @db.VarChar(120)
  status     CatalogLifecycle  @default(DRAFT)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  products   ProductCategory[]

  @@index([status, name])
}

model ProductCategory {
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId  String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String   @db.Uuid
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId, position, productId])
}

model ProductMedia {
  id         String           @id @default(uuid()) @db.Uuid
  product    Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId  String           @db.Uuid
  storageKey String           @db.VarChar(255)
  altText    String           @db.VarChar(500)
  width      Int
  height     Int
  position   Int              @default(0)
  status     CatalogLifecycle @default(DRAFT)
  archivedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([productId, storageKey])
  @@unique([productId, position])
  @@index([productId, status, position])
}

model PriceBook {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique @db.VarChar(64)
  name         String             @db.VarChar(120)
  marketCode   String             @db.Char(2)
  currencyCode String             @db.Char(3)
  createdAt    DateTime           @default(now())
  versions     PriceBookVersion[]
}

model PriceBookVersion {
  id               String                    @id @default(uuid()) @db.Uuid
  priceBook        PriceBook                 @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  priceBookId      String                    @db.Uuid
  version          Int
  lifecycle        PriceBookVersionLifecycle @default(DRAFT)
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  activatedAt      DateTime?
  retiredAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  prices           VariantPrice[]
  commercePolicies CommercePolicyVersion[]
  orders           Order[]

  @@unique([priceBookId, version])
  @@index([priceBookId, lifecycle])
}

model VariantPrice {
  id                 String           @id @default(uuid()) @db.Uuid
  priceBookVersion   PriceBookVersion @relation(fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  priceBookVersionId String           @db.Uuid
  variant            ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId          String           @db.Uuid
  amountMinor        BigInt
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([priceBookVersionId, variantId])
  @@index([variantId, priceBookVersionId])
}

model Warehouse {
  id                String                     @id @default(uuid()) @db.Uuid
  code              String                     @unique @db.VarChar(64)
  name              String                     @db.VarChar(120)
  countryCode       String                     @db.Char(2)
  status            WarehouseStatus            @default(ACTIVE)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  balances          InventoryBalance[]
  movements         InventoryMovement[]
  reservationItems  InventoryReservationItem[]
  fulfillmentGroups FulfillmentGroup[]

  @@index([status, countryCode])
}

model InventoryBalance {
  id          String         @id @default(uuid()) @db.Uuid
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId   String         @db.Uuid
  onHand      Int
  reserved    Int            @default(0)
  allocated   Int            @default(0)
  damaged     Int            @default(0)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId, warehouseId])
}

model InventoryMovement {
  id                 String                @id @default(uuid()) @db.Uuid
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId        String                @db.Uuid
  variant            ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId          String                @db.Uuid
  type               InventoryMovementType
  onHandDelta        Int                   @default(0)
  reservedDelta      Int                   @default(0)
  allocatedDelta     Int                   @default(0)
  damagedDelta       Int                   @default(0)
  resultingOnHand    Int
  resultingReserved  Int
  resultingAllocated Int
  resultingDamaged   Int
  commandId          String                @db.Uuid
  commandSequence    Int                   @default(1)
  actorType          AuditActorType
  actorId            String                @db.VarChar(128)
  reason             String                @db.VarChar(500)
  occurredAt         DateTime              @default(now())

  @@unique([commandId, commandSequence])
  @@index([warehouseId, variantId, occurredAt])
  @@index([variantId, occurredAt])
}

model Cart {
  id                String     @id @default(uuid()) @db.Uuid
  tokenDigest       String     @unique @db.Char(64)
  revision          Int        @default(1)
  status            CartStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastAccessedAt    DateTime   @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  items             CartItem[]
  orders            Order[]

  @@index([expiresAt])
  @@index([absoluteExpiresAt])
  @@index([lastAccessedAt])
  @@index([status, updatedAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model CommercePolicyVersion {
  id                         String                  @id @default(uuid()) @db.Uuid
  version                    Int                     @unique
  lifecycle                  CommercePolicyLifecycle @default(DRAFT)
  effectiveFrom              DateTime?
  effectiveUntil             DateTime?
  countryCode                String                  @db.Char(2)
  currencyCode               String                  @db.Char(3)
  shippingBaseMinor          Int
  freeShippingThresholdMinor Int
  heavySurchargeMinor        Int
  heavyThresholdGrams        Int
  taxRateBasisPoints         Int
  reservationDurationSeconds Int
  calculationVersion         String                  @db.VarChar(64)
  priceBookVersion           PriceBookVersion        @relation(fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  priceBookVersionId         String                  @db.Uuid
  createdAt                  DateTime                @default(now())
  orders                     Order[]

  @@index([countryCode, currencyCode, lifecycle, effectiveFrom])
}

model InventoryReservation {
  id            String                     @id @default(uuid()) @db.Uuid
  status        ReservationStatus          @default(ACTIVE)
  expiresAt     DateTime
  order         Order?                     @relation("OrderOriginalReservation")
  recoveryOrder Order?                     @relation("OrderRecoveryReservation")
  items         InventoryReservationItem[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([status, expiresAt])
  @@index([status, updatedAt])
}

model InventoryReservationItem {
  id            String               @id @default(uuid()) @db.Uuid
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reservationId String               @db.Uuid
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId   String               @db.Uuid
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId     String               @db.Uuid
  quantity      Int

  @@unique([reservationId, variantId])
  @@index([warehouseId, variantId])
}

model Order {
  id                      String                 @id @default(uuid()) @db.Uuid
  reference               String                 @unique @db.VarChar(32)
  status                  OrderStatus            @default(PENDING_PAYMENT)
  cart                    Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  cartId                  String                 @db.Uuid
  policyVersion           CommercePolicyVersion  @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  policyVersionId         String                 @db.Uuid
  priceBookVersion        PriceBookVersion       @relation(fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  priceBookVersionId      String                 @db.Uuid
  reservation             InventoryReservation   @relation("OrderOriginalReservation", fields: [reservationId], references: [id], onDelete: Restrict)
  reservationId           String                 @unique @db.Uuid
  recoveryReservation     InventoryReservation?  @relation("OrderRecoveryReservation", fields: [recoveryReservationId], references: [id], onDelete: Restrict)
  recoveryReservationId   String?                @unique @db.Uuid
  currencyCode            String                 @db.Char(3)
  subtotalMinor           BigInt
  shippingMinor           BigInt
  taxMinor                BigInt
  totalMinor              BigInt
  calculationSnapshot     Json
  shippingAddressSnapshot Json
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  lines                   OrderLine[]
  paymentAttempts         PaymentAttempt[]
  paymentCompensations    PaymentCompensation[]
  fulfillmentGroups       FulfillmentGroup[]
  guestAccessGrant        GuestOrderAccessGrant?

  @@index([cartId, createdAt])
  @@index([status, createdAt])
  @@index([priceBookVersionId])
}

model GuestOrderAccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId     String    @unique @db.Uuid
  tokenDigest String    @unique @db.Char(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

model OrderLine {
  id                   String                 @id @default(uuid()) @db.Uuid
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId              String                 @db.Uuid
  variant              ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId            String                 @db.Uuid
  productNameSnapshot  String                 @db.VarChar(160)
  variantNameSnapshot  String                 @db.VarChar(160)
  skuSnapshot          String                 @db.VarChar(64)
  optionValuesSnapshot Json
  taxClassSnapshot     String                 @db.VarChar(64)
  weightGramsSnapshot  Int
  mediaSnapshot        Json
  quantity             Int
  unitPriceMinor       BigInt
  lineSubtotalMinor    BigInt
  lineTaxMinor         BigInt
  lineTotalMinor       BigInt
  fulfillmentItems     FulfillmentGroupItem[]

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([variantId])
}

model PaymentAttempt {
  id                     String               @id @default(uuid()) @db.Uuid
  order                  Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId                String               @db.Uuid
  status                 PaymentAttemptStatus @default(PROCESSING)
  provider               String               @db.VarChar(32)
  paymentMethodReference String               @db.VarChar(64)
  providerPaymentId      String?              @db.VarChar(128)
  providerReference      String?              @db.VarChar(128)
  failureCode            String?              @db.VarChar(64)
  amountMinor            BigInt
  currencyCode           String               @db.Char(3)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  compensation           PaymentCompensation?

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([status, updatedAt])
}

model PaymentCompensation {
  id                     String                    @id @default(uuid()) @db.Uuid
  order                  Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId                String                    @db.Uuid
  paymentAttempt         PaymentAttempt            @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  paymentAttemptId       String                    @unique @db.Uuid
  reason                 PaymentCompensationReason
  status                 PaymentCompensationStatus @default(REQUIRED)
  provider               String                    @db.VarChar(32)
  providerCompensationId String?                   @db.VarChar(128)
  amountMinor            BigInt
  currencyCode           String                    @db.Char(3)
  processingStartedAt    DateTime?
  completedAt            DateTime?
  failureCode            String?                   @db.VarChar(64)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([provider, providerCompensationId])
  @@index([orderId, createdAt])
  @@index([status, createdAt, id])
}

model PaymentWebhookInbox {
  id                 String                    @id @default(uuid()) @db.Uuid
  provider           String                    @db.VarChar(32)
  providerEventId    String                    @db.VarChar(128)
  eventType          PaymentWebhookEventType
  providerObjectId   String                    @db.VarChar(128)
  apiVersion         String                    @db.VarChar(32)
  livemode           Boolean
  providerCreatedAt  DateTime
  receivedAt         DateTime                  @default(now())
  normalizedData     Json
  payloadDigest      String                    @db.Char(64)
  status             PaymentWebhookInboxStatus @default(PENDING)
  processingAttempts Int                       @default(0)
  claimTokenDigest   String?                   @db.Char(64)
  claimedAt          DateTime?
  leaseExpiresAt     DateTime?
  processedAt        DateTime?
  failureCode        String?                   @db.VarChar(64)
  updatedAt          DateTime                  @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, receivedAt, id])
  @@index([provider, providerObjectId, providerCreatedAt])
}

model FulfillmentGroup {
  id                String                        @id @default(uuid()) @db.Uuid
  order             Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId           String                        @db.Uuid
  warehouse         Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId       String                        @db.Uuid
  status            FulfillmentGroupStatus        @default(ALLOCATED)
  version           Int                           @default(1)
  pickingStartedAt  DateTime?
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  carrierCode       String?                       @db.VarChar(32)
  trackingReference String?                       @db.VarChar(64)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  items             FulfillmentGroupItem[]
  transitionResults FulfillmentTransitionResult[]

  @@unique([orderId, warehouseId])
  @@index([orderId])
  @@index([status, createdAt])
}

model FulfillmentTransitionResult {
  id                  String                 @id @default(uuid()) @db.Uuid
  idempotencyRecord   IdempotencyRecord      @relation(fields: [idempotencyRecordId], references: [id], onDelete: Cascade)
  idempotencyRecordId String                 @unique @db.Uuid
  fulfillmentGroup    FulfillmentGroup       @relation(fields: [fulfillmentGroupId], references: [id], onDelete: Restrict)
  fulfillmentGroupId  String                 @db.Uuid
  orderId             String                 @db.Uuid
  warehouseId         String                 @db.Uuid
  status              FulfillmentGroupStatus
  version             Int
  pickingStartedAt    DateTime?
  packedAt            DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  carrierCode         String?                @db.VarChar(32)
  trackingReference   String?                @db.VarChar(64)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime

  @@index([fulfillmentGroupId, version])
}

model FulfillmentGroupItem {
  id                 String           @id @default(uuid()) @db.Uuid
  fulfillmentGroup   FulfillmentGroup @relation(fields: [fulfillmentGroupId], references: [id], onDelete: Restrict)
  fulfillmentGroupId String           @db.Uuid
  orderLine          OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  orderLineId        String           @db.Uuid
  quantity           Int

  @@unique([fulfillmentGroupId, orderLineId])
  @@index([orderLineId])
}
